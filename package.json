{
  "name": "@vshome/ui",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./charts": {
      "types": "./dist/charts/index.d.ts",
      "import": "./dist/charts.js"
    },
    "./vite": {
      "types": "./dist/node/vite.d.ts",
      "import": "./dist/node/vite.js"
    },
    "./test-setup": {
      "types": "./dist/node/test-setup.d.ts",
      "import": "./dist/node/test-setup.js"
    },
    "./style.css": "./dist/style.css",
    "./tsconfig.base.json": "./dist/tsconfig.base.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && tsc -p tsconfig.node.json && cp tsconfig.base.json dist/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "showcase": "vite --config vite.showcase.config.ts",
    "showcase:build": "vite build --config vite.showcase.config.ts"
  },
  "dependencies": {
    "vite-plugin-singlefile": "2.3.3"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.8.0",
    "@tanstack/react-query": "^5.0.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@vitejs/plugin-react": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vitest": {
      "optional": true
    },
    "@testing-library/react": {
      "optional": true
    },
    "@testing-library/jest-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@base-ui/react": "1.8.0",
    "@tanstack/react-query": "5.104.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "30.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.5",
    "vitest": "4.1.8"
  }
}
